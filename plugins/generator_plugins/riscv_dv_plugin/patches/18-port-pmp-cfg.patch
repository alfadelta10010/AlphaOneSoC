+        for i in range(self.pmp_cfg.pmp_num_regions):
+            region = getattr(self.argv, 'pmp_region_{}'.format(i), "")
+            if region:
+                self.pmp_cfg.pmp_region_args[i] = region
+        self.pmp_cfg.initialize(self.require_signature_addr)
