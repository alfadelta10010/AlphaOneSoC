+            pmp_cfg.rand_mode(pmp_cfg.pmp_randomize);
+            pmp_cfg.initialize(require_signature_addr);
+
+        which pyflow left as a comment (`# pmp_cfg = riscv_pmp_cfg  # TODO`).
