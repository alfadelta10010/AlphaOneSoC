# WO-66: broken copies of src/cache.v; the induction harness cache_ind (EN free) must FAIL each.
# takes the fetch path over while a pass-through request is still in flight on mem_ctrl
sed cache.v s@wire        on    = !act \&\& en \&\& (!f_req || m_ready);@wire        on    = !act \&\& en;@
# hands the fetch path back while a fill is running (m_req and its address vanish before m_ready)
sed cache.v s@wire        off   = act \&\& !en \&\& !fill_active \&\& !hit_q;@wire        off   = act \&\& !en \&\& !hit_q;@
# the fill address has the wrong window byte (bit 29 not rebuilt): M-A2 broken
sed cache.v s@1'b0, ~fill_tag\[16\], 5'd0@1'b0, fill_tag[16], 5'd0@
# the word counter runs without a ready: the held address moves
sed cache.v s@            if (word_in) begin@            if (fill_active) begin@
# f_ready from a fill word: ready without a request
sed cache.v s@assign f_ready = act ? hit_q : m_ready;@assign f_ready = act ? (hit_q || word_in) : m_ready;@
# the cache is active out of reset
sed cache.v s@            act         <= 1'b0;@            act         <= 1'b1;@
# valid bits survive the hand-back (not cold): the !act -> valid = 0 invariant breaks
sed cache.v /on the way out/{n;s@valid <= 16'd0;@valid <= valid;@}
# WO-CF B1: sector-tag invariant (I6-I8). The sibling sector survives a tag change (stale data of the old tag stays valid)
sed cache.v s@if (!tmatch) valid\[{kline, ~kidx\[0\]}\] <= 1'b0;@@
# the sibling is dropped only when the even sector starts the fill (a three-fill sequence: needs the induction to see it)
sed cache.v s@if (!tmatch) valid\[{kline, ~kidx\[0\]}\] <= 1'b0;@if (!tmatch \&\& !kidx[0]) valid[{kline, ~kidx[0]}] <= 1'b0;@
# a store to another tag of the same index rewrites the line's tag without dropping the sectors (a snoop-side tag refresh)
sed cache.v s@^            if (snoop \&\& tmatch) begin@            if (snoop) tags[17*kline +: 17] <= ktag;\n&@
# the new tag is not written when the sibling sector is still valid (the running fill's line keeps the old tag)
sed cache.v s@^                tags\[17\*kline +: 17\] <= ktag;@                if (!valid[{kline, ~kidx[0]}]) tags[17*kline +: 17] <= ktag;@
# MUT9 (4x4-reviewer): the fill-start clear of the filled sector's valid bit is deleted (line-anchored: line 182 has the same text); I6-I8 still hold, I9 fails
sed cache.v 170s@valid\[kidx\] <= 1'b0;@@
# WO-CF B2: M-A5, m_burst on a flash fill (window 0x20: m_addr[31] = 0)
sed cache.v s@fill_active \&\& !dead \&\& fill_tag\[16\] \&\& pburst@fill_active \&\& !dead \&\& pburst@
# m_burst without a running fill (no m_req)
sed cache.v s@assign m_burst = act \&\& fill_active \&\& !dead \&\& fill_tag\[16\] \&\& pburst;@assign m_burst = act \&\& !dead \&\& fill_tag[16] \&\& pburst;@
