# EQY configuration template; tb/eqy/run.sh fills in @GOLD@, @GATE@.
# gold = the branch RTL, gate = the hardened netlist. See run.sh and WO-24.

[options]
# (no `splitnets on`: it would split the FSM buses; the scripts split the nets)

[gold]
script @GOLD@

[gate]
script @GATE@

# ---- matching -------------------------------------------------------------
# By name, one name per net. The FSM registers are not matched (below).
# One name per net (tb/eqy/matchrules.py): see its header.
[match *]
gold-nomatch soc.clint_inst.mtime_d*
gate-nomatch soc.clint_inst.mtime_d*
gold-nomatch soc.cpu.csr_unit.mcycle_d*
gate-nomatch soc.cpu.csr_unit.mcycle_d*
gold-nomatch soc.cpu.csr_unit.minstret_d*
gate-nomatch soc.cpu.csr_unit.minstret_d*
gold-nomatch soc.cpu.rf.dIn*
gate-nomatch soc.cpu.rf.dIn*
gold-nomatch soc.cpu.rf.w_ena*
gate-nomatch soc.cpu.rf.w_ena*
gold-nomatch soc.qspi.rd_late*
gate-nomatch soc.qspi.rd_late*
gold-nomatch soc.cpu.exwb_memSize*
gate-nomatch soc.cpu.exwb_memSize*
gold-nomatch soc.cpu.muldiv_inst.st*
gate-nomatch soc.cpu.muldiv_inst.st*
gold-nomatch soc.qspi.state*
gate-nomatch soc.qspi.state*
@MATCHRULES@

# ---- FSM registers ---------------------------------------------------------
# EQY 0.62's [recode] does not cut the gate side (the one-hot flops stay in
# the partitions with a free initial state), so the 24 FSM flops (8 gold, 16
# gate) are not matched; run.sh gives them their reset value as `init`
# (gold 0, gate the one-hot image of state 0) and the partitions that hold
# them are proved from that state.

# ---- strategies -----------------------------------------------------------
# sat: EQY's built-in temporal induction. pdr: sby with abc pdr, only for the
# partitions sat leaves open. No SMT solver exists on the sandbox.
[strategy sat]
use sat
depth 5

[strategy pdr]
use sby
engine abc pdr
depth 20
timeout 600
# no SMT solver: sby must not try to replay a trace with one
option aigsmt none
