# EQY configuration template; tb/eqy/run.sh fills in @GOLD@, @GATE@.
# gold = the branch RTL, gate = the hardened netlist. See run.sh and WO-24.

[options]
# (no `splitnets on`: it would split the FSM buses; the scripts split the nets)

[gold]
script @GOLD@

[gate]
script @GATE@

# ---- matching -------------------------------------------------------------
# By name, one name per net. The FSM registers are not matched (below).
# One name per net (tb/eqy/matchrules.py): see its header.
[match *]
gold-nomatch soc.clint_inst.mtime_d*
gate-nomatch soc.clint_inst.mtime_d*
gold-nomatch soc.cpu.csr_unit.mcycle_d*
gate-nomatch soc.cpu.csr_unit.mcycle_d*
gold-nomatch soc.cpu.csr_unit.minstret_d*
gate-nomatch soc.cpu.csr_unit.minstret_d*
gold-nomatch soc.cpu.rf.dIn*
gate-nomatch soc.cpu.rf.dIn*
gold-nomatch soc.cpu.rf.w_ena*
gate-nomatch soc.cpu.rf.w_ena*
# syscon's ns_now = rst ? strap_no_stream : strap_ns_q is strap_ns_q's own D in the netlist, but the RTL flop
# is written only in reset (an enable), so its D cone never contains ns_now: matched, ns_now is a free cut input
# of the strap_ns_q partition and the proof needs induction length 4. Unmatched, both sides see the whole cone.
gold-nomatch soc.syscon_inst.ns_now*
gate-nomatch soc.syscon_inst.ns_now*
gold-nomatch soc.qspi.rd_late*
gate-nomatch soc.qspi.rd_late*
gold-nomatch soc.cpu.exwb_memSize*
gate-nomatch soc.cpu.exwb_memSize*
gold-nomatch soc.cpu.muldiv_inst.st*
gate-nomatch soc.cpu.muldiv_inst.st*
gold-nomatch soc.qspi.state*
gate-nomatch soc.qspi.state*
gold-nomatch soc.gpio_inst.spi_inst.st*
gate-nomatch soc.gpio_inst.spi_inst.st*
@MATCHRULES@

# ---- FSM cut point ----------------------------------------------------------
# EQY 0.62's [recode] does not cut the gate side, so the four recoded FSMs
# (exwb_memSize, muldiv_inst.st, qspi.state, spi_inst.st) are not matched. run.sh instead patches
# both designs (fsmcut.py): gold's flop Q moves to <cut> (soc.cpu.fsmcut_exwb_memSize,
# soc.cpu.muldiv_inst.fsmcut_st, soc.qspi.fsmcut_state, soc.gpio_inst.spi_inst.fsmcut_st) and readers see clamp(<cut>); the
# gate's one-hot flops move to <name>__oh and <cut> = enc(oh), readers see
# onehot(clamp(<cut>)). <cut> has the same name on both sides, so it is matched and cut:
# every other partition loses the FSM, and each FSM is one small partition checking the
# synthesized FSM and the table. No FSM init (EQY's sat strategy proves from any state);
# the one-hot invariant of the gate is the fsminv stage. The rf_top w_ena pin has its own
# net (soc.cpu.rf.w_ena_pin, covered by the w_ena* nomatch above; the black box's port
# match compares it).

# ---- strategies -----------------------------------------------------------
# sat: EQY's built-in temporal induction. pdr: sby with abc pdr, only for the
# partitions sat leaves open. No SMT solver exists on the sandbox.
[strategy sat]
use sat
depth 5

[strategy pdr]
use sby
engine abc pdr
depth 20
timeout 600
# no SMT solver: sby must not try to replay a trace with one
option aigsmt none
# sat has no timeout in EQY 0.62 and amo_old_val.0 (11.5k cells) never answers: straight to pdr
noapply tt_um_alfadelta10010_alphaone_soc.soc.cpu.amo_old_val.0
