# Flash is read-only and not reservable: LR -> cause 5; SC, AMO, sw, sh, sb
# and c.sw -> 7; mtval = the address. Spike maps flash as plain RAM, so this
# is DUT-only. x18 holds the causes in order, x20 the traps with a wrong
# mtval.
pma_flash           expect x18=0x5777777 x20=0x0 x30=0x0

# Timer interrupts at a period a QSPI-speed handler can keep up with; the
# timer counts clocks and Spike counts instructions, so DUT-only. x18 = taken,
# x20 = taken with the wrong cause or an mepc outside the wait loop.
t_irq_slow          expect x18=0x3 x20=0x0

# WFI woken by the timer: during the wait (mepc = WFI+4), with MIE=0 (no trap,
# MTIP then pending in mip), and with the interrupt already takeable as the
# WFI arrives (mepc = WFI+4 again; Spike, just as legally, uses the WFI's pc).
# The timer counts clocks, so DUT-only; wfi_slow.S lists the registers.
wfi_slow            expect x9=0x0 x10=0x0 x18=0x2 x20=0x80000007 x21=0x77 x22=0x80
wfi_slow            expect x9=0x0 x10=0x0 x18=0x2 x20=0x80000007 x21=0x77 x22=0x80 -- +IMEM_WAIT=3 +IMEM_RANDOM=1 +DMEM_WAIT=2 +DMEM_RANDOM=1

# Timer interrupts landing on M ops, loads and stores to both PSRAMs, an AMO
# and page- and chip-straddling fetches: the checksum with interrupts on must
# equal the one with them off (x21, Spike's value for that loop), and every
# interrupt must have had the timer's cause (x9). DUT-only, as t_irq_slow.
irq_stress          expect x9=0x1 x21=0xf08894e2 x25=0x0
irq_stress          expect x9=0x1 x21=0xf08894e2 x25=0x0 -- +IMEM_WAIT=3 +IMEM_RANDOM=1 +DMEM_WAIT=2 +DMEM_RANDOM=1

# Boots from flash (SoC only): runs from flash, copies a routine into PSRAM
# and runs it there after FENCE.I, the way a boot loader hands over.
flash_boot          flash
# The flash-end twin of straddle_top (SoC only: boots from flash).
straddle_flash_end  flash

# ---- SoC only: hostile hand-over, late sampling, SoC-speed variants ---------
# The QSPI Pmod handed over in states the start-up sequence must undo, and
# a 25 ns round trip through the rd_late strap (hold 12 ns, more than a
# clock) on page-wrapping PSRAM. Spike's trace does not depend on timing,
# so flash_boot is still compared line for line.
flash_boot          soc spike +FLASH_DCRM +PSRAM_A_QPI
flash_boot          soc spike +FLASH_QPI +FLASH_CRM +PSRAM_QPI
flash_boot          soc spike +RD_LATE +QSPI_DELAY=25 +QSPI_HOLD=12 +PSRAM_WRAP
irq_stress          soc expect x9=0x1 x21=0xf08894e2 x25=0x0 -- +RD_LATE +QSPI_DELAY=25 +QSPI_HOLD=12 +PSRAM_WRAP +PSRAM_QPI +FLASH_CRM
# t_ctl's LR/SC loop at a 2000-clock period (t_ctl_slow.S says why).
t_ctl_slow          soc expect x8=0x64 x25=0x64 x20=0x1

#soc-skip cnt_xhalf -- its mcycle cases read the cycle counter, which counts clocks: at QSPI speed each instruction is tens of clocks, while Spike counts one per instruction. The minstret cases are covered at the core level.
#soc-skip t_irq t_irq2 t_mulirq t_ctl -- their timer periods (40, 37, 50 and 100 clocks) are shorter than an interrupt handler at QSPI speed (about 60 clocks per instruction), so the handler never finishes before the next interrupt and the loop never advances. Legal; these tests assume a fast memory. t_ctl_slow runs t_ctl's LR/SC loop at SoC speed instead.
