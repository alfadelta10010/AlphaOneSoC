# Directed regression manifest -- read by run.sh.
#
#   <name> spike  [+PLUSARG...]                          full-trace compare vs <name>.ref
#   <name> expect <reg>=<hex>... [-- +PLUSARG...]        DUT only (deliberate divergence)
#
# Every .S in this directory must appear here. Memory timing matters: fixed
# waits, random waits, zero waits and garbage not-ready data each expose
# different bugs, so the stall-sensitive tests run under several.

# ---- memory handshake, loads/stores, atomics ----------------------------------
memops              spike
memops              spike  +DMEM_WAIT=3
memops              spike  +IMEM_WAIT=3 +IMEM_RANDOM=1 +DMEM_WAIT=3 +DMEM_RANDOM=1 +NOTREADY_DATA=2
atomics             spike
atomics             spike  +DMEM_WAIT=3
atomics             spike  +IMEM_WAIT=2 +IMEM_RANDOM=1 +DMEM_WAIT=3 +DMEM_RANDOM=1
t_amo               spike
t_amo               spike  +DMEM_WAIT=2 +DMEM_RANDOM=1
t_memstress         spike
t_memstress         spike  +IMEM_WAIT=1 +DMEM_WAIT=3 +DMEM_RANDOM=1
ptrchase            spike  +DMEM_WAIT=2 +NOTREADY_DATA=1
ptrchase            spike  +DMEM_WAIT=3 +DMEM_RANDOM=1 +NOTREADY_DATA=2
amo_chase           spike  +DMEM_WAIT=2 +NOTREADY_DATA=1
amo_chase           spike  +DMEM_WAIT=3 +DMEM_RANDOM=1 +NOTREADY_DATA=2

# ---- LR/SC ------------------------------------------------------------------
lrsc_io             spike
sc_trap             spike
sc_trap             spike  +DMEM_WAIT=3
# Same-hart store/AMO to the reserved word clears the reservation here and
# not on Spike; both are legal (the sequence is unconstrained).
lrsc_policy         expect x10=0x1 x11=0x1 x12=0x1 x13=0x1 x14=0x0
lrsc_policy         expect x10=0x1 x11=0x1 x12=0x1 x13=0x1 x14=0x0 -- +DMEM_WAIT=3
lr_sb_sc            expect x11=0x1 x12=0x1 x13=0x1

# ---- multiply / divide --------------------------------------------------------
mul_chain           spike
mul_chain           spike  +IMEM_WAIT=1
mul_chain           spike  +IMEM_WAIT=2
mul_chain           spike  +IMEM_WAIT=3 +IMEM_RANDOM=1 +DMEM_WAIT=2 +DMEM_RANDOM=1
t_mul               spike
t_mul               spike  +IMEM_WAIT=2
t_mul               spike  +IMEM_WAIT=5
t_div               spike
t_div               spike  +IMEM_WAIT=2
mul_fetchfault      spike
mul_fetchfault      spike  +IMEM_WAIT=2
mul_pmpx            spike

# ---- traps, exception priority, mtval -----------------------------------------
causes              spike
causes              spike  +IMEM_WAIT=2 +DMEM_WAIT=2
illegal_ld_misalign spike
illegal_sd_misalign spike
illegal_ld_aligned  spike
lw_misalign         spike
c_misalign          spike
enc_probe           spike

# ---- MRET, interrupts --------------------------------------------------------------
mret_stall          spike
mret_stall          spike  +IMEM_WAIT=3 +IMEM_RANDOM=1
mret_ctrl           spike
mret_ctrl           spike  +IMEM_WAIT=2
mret_fault          spike
mret_far            spike  +IMEM_WAIT=3
t_csrmret           spike
t_csrmret           spike  +DMEM_WAIT=3
mret_irq            spike
mret_irq            spike  +IMEM_WAIT=3 +IMEM_RANDOM=1
mie_enable          spike
# Spike takes this interrupt before the csrc (its msip store is visible at
# once); the core takes it after the store lands, by which time mie is off.
# Both legal; what matters is that it is never taken after the disable.
mie_disable         expect x14=0x999
# Timer-driven: mtime ticks per clock here and per ~100 retires on Spike, so
# these cannot be lockstep-compared. They check the program completes with
# no interrupt landing at a bad mepc; randomised waits are what used to
# expose the double-injection bug.
t_irq               expect x8=0x190 x25=0x0
t_irq               expect x8=0x190 x25=0x0 -- +DMEM_WAIT=2 +DMEM_RANDOM=1
t_irq2              expect x8=0x7d0 x25=0x0
t_irq2              expect x8=0x7d0 x25=0x0 -- +IMEM_WAIT=1 +DMEM_WAIT=2 +DMEM_RANDOM=1
t_mulirq            expect x8=0x14
t_mulirq            expect x8=0x14 -- +IMEM_WAIT=2 +DMEM_WAIT=1 +DMEM_RANDOM=1
t_ctl               expect x8=0x64 x25=0x64
t_ctl               expect x8=0x64 x25=0x64 -- +IMEM_WAIT=1 +DMEM_WAIT=3 +DMEM_RANDOM=1

# ---- CSRs --------------------------------------------------------------------------
csrfwd              spike
csrlog_probe        spike
cnt_alias           spike
marchid             spike
mip_ro              spike
misa_adjacent       spike
mpp_warl            spike
mstatus_bits        spike
t_mstatus           spike
t_mepc              spike
t_warl              spike
# Reset values per spec: PMP off (Spike resets it permissive), mstatus 0.
t_reset             expect x8=0x0 x9=0x0 x18=0x0 x19=0x0 x20=0x40101105 x21=0x0 x22=0x0 x23=0x0 x24=0x0

# ---- PMP, MPRV, U-mode ---------------------------------------------------------
pmpcfg              spike
pmp_rw_reserved     spike
pmp_adjacent        spike
pmp_adjacent_x      spike
pmp_napot_small     spike
pmp_napot_hi        spike
pmp_tor4g           spike
mprv                spike
mprv2               spike
t_umode             spike

