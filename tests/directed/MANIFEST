mie_enable          spike
# Spike takes this interrupt before the csrc (its msip store is visible at
# once); the core takes it after the store lands, by which time mie is off --
# unless the pipeline is still waiting on a fetch when the store lands, as it
# is behind the QSPI memory, and then the core takes it before the csrc too
# (mepc = the csrc, 0x80000030). Both legal; what matters is that it is never
# taken after the disable.
mie_disable         expect x14=0x999|0x80000030
# Timer-driven: mtime ticks per clock here and per ~100 retires on Spike, so
# these cannot be lockstep-compared. They check the program completes with
# no interrupt landing at a bad mepc; randomised waits are what used to
# expose the double-injection bug.
t_irq               expect x8=0x190 x25=0x0
t_irq               expect x8=0x190 x25=0x0 -- +DMEM_WAIT=2 +DMEM_RANDOM=1
t_irq2              expect x8=0x7d0 x25=0x0
t_irq2              expect x8=0x7d0 x25=0x0 -- +IMEM_WAIT=1 +DMEM_WAIT=2 +DMEM_RANDOM=1
t_mulirq            expect x8=0x14
t_mulirq            expect x8=0x14 -- +IMEM_WAIT=2 +DMEM_WAIT=1 +DMEM_RANDOM=1
t_ctl               expect x8=0x64 x25=0x64
t_ctl               expect x8=0x64 x25=0x64 -- +IMEM_WAIT=1 +DMEM_WAIT=3 +DMEM_RANDOM=1
# An interrupt between an LR and its SC clears the reservation: the SC fails
# (x10 = 1), where the same sequence with MIE off succeeds (x12 = 0). Placed
# there by construction, so it holds at any speed and runs through the SoC
# too. DUT-only: the timer counts clocks.
lrsc_trap_clear     expect x10=0x1 x12=0x0 x19=0x1 x11=0x77
lrsc_trap_clear     expect x10=0x1 x12=0x0 x19=0x1 x11=0x77 -- +DMEM_WAIT=3
lrsc_trap_clear     expect x10=0x1 x12=0x0 x19=0x1 x11=0x77 -- +IMEM_WAIT=3 +IMEM_RANDOM=1 +DMEM_WAIT=2 +DMEM_RANDOM=1
# The registered MTIP's stale window (mtip_stale.S says more): after a store
# moves mtimecmp away, mip.MTIP still reads 1 for two clocks. With a fast
# memory no instruction reads mip that soon after the store any more (EX
# takes three cycles), so every read is 0; when the store waits for its
# memory the instruction behind it has done its EX cycles meanwhile and
# reads mip the clock after the store, 0x80 (x22, third line). MIE set
# straight after the store catches nothing either way (x18 = 0, the handler
# never runs). Legal either way (Priv 3.2.1); Spike updates MTIP at once, so
# DUT-only. The first line (the one the SoC run takes) accepts either
# outcome; the others pin it. The waits of the third are fixed, not random:
# a random wait depends on the clock count before it, and would move with
# any change of timing.
mtip_stale          expect x19=0x80 x20=0x0 x22=0x80|0x0 x23=0x80|0x0 x24=0x0 x18=0x1|0x0 x12=0x0|0xffffffff
mtip_stale          expect x19=0x80 x20=0x0 x22=0x0 x23=0x0 x24=0x0 x18=0x0 x12=0xffffffff
mtip_stale          expect x19=0x80 x20=0x0 x22=0x80 x23=0x0 x24=0x0 x18=0x0 x12=0xffffffff -- +DMEM_WAIT=3

